# ---- secrets ----
.env
workspace/.env
*.key

# ---- local environment data (never commit; rebuilt by workspace/env/*.bat) ----
/env/
!env/conda/.gitkeep
!env/docker/.gitkeep
third_party/
!third_party/.gitkeep

# ---- run artifacts (large / regenerable). Final submission copies are curated manually ----
workspace/logs/*
!workspace/logs/.gitkeep
# 彩排样例入库（提交材料 logs/ 结构的真实样本，~1.6MB）；work/ 工作副本不要
!workspace/logs/rehearsal/
workspace/logs/rehearsal/**/work/
workspace/results/**
!workspace/results/.gitkeep
workspace/candidates/**
!workspace/candidates/.gitkeep
workspace/baseline/**
!workspace/baseline/.gitkeep

# ---- python ----
__pycache__/
*.pyc
.pytest_cache/

# ---- misc ----
*.vhdx
*.tar
*.tar.gz
*.log
.DS_Store
Thumbs.db

# Organizer-provided contest kit and copied notices stay local.
/1/材料补全/
/1/关于离线专家知识注入的说明.pdf
/关于离线专家知识注入的说明.pdf
